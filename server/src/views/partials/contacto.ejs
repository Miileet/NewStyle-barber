<section class="section section--alt" id="contacto">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="eyebrow__line"></span>06 — Contacto</p>
      <h2 class="section-title">Ubicación y contacto</h2>
    </div>

    <div class="contact">
      <div class="contact__info reveal">
        <ul class="contact__list">
          <li class="contact__row">
            <span class="contact__label">Dirección</span>
            <span class="contact__value"><%- marcarDato(site.contacto.direccion) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">Teléfono</span>
            <span class="contact__value"><%- marcarDato(site.contacto.telefono) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">WhatsApp</span>
            <span class="contact__value"><%- marcarDato(site.contacto.whatsapp) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">Email</span>
            <span class="contact__value"><%- marcarDato(site.contacto.email) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">Medios de pago</span>
            <span class="contact__value"><%- marcarDato(site.contacto.mediosPago) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">Instagram</span>
            <span class="contact__value"><%- marcarDato(site.contacto.instagram) %></span>
          </li>
          <li class="contact__row">
            <span class="contact__label">Facebook</span>
            <span class="contact__value"><%- marcarDato(site.contacto.facebook) %></span>
          </li>
        </ul>

        <div class="contact__actions">
          <% const telDisponible = site.contacto.telefono && !esPlaceholder(site.contacto.telefono); %>
          <% const waDisponible = site.contacto.whatsappUrl && !esPlaceholder(site.contacto.whatsappUrl); %>

          <% if (waDisponible) { %>
            <a class="btn btn--light" href="<%= site.contacto.whatsappUrl %>" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
          <% } else { %>
            <span class="btn btn--light is-disabled" aria-disabled="true">Escribir por WhatsApp</span>
          <% } %>

          <% if (telDisponible) { %>
            <a class="btn btn--ghost" href="tel:<%= String(site.contacto.telefono).replace(/\s+/g, "") %>">Llamar</a>
          <% } else { %>
            <span class="btn btn--ghost is-disabled" aria-disabled="true">Llamar</span>
          <% } %>

          <% if (site.contacto.comoLlegar) { %>
            <a class="btn btn--ghost" href="<%= site.contacto.comoLlegar %>" target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          <% } %>
        </div>

        <% if (esPlaceholder(site.contacto.telefono) || esPlaceholder(site.contacto.whatsapp)) { %>
          <p class="contact__hint">
            Los botones de WhatsApp y llamada se habilitan al completar
            <code>whatsappUrl</code> y <code>telefono</code> en <code>src/data/site.js</code>.
          </p>
        <% } %>
      </div>

      <div class="contact__map reveal" style="--delay: .15s">
        <% if (site.contacto.mapa) { %>
          <%- site.contacto.mapa %>
        <% } else { %>
          <div class="map-placeholder">
            <svg class="map-placeholder__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-5.4-7-11a7 7 0 0 1 14 0c0 5.6-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.6" />
            </svg>
            <p class="map-placeholder__title">Google Maps</p>
            <p class="map-placeholder__text">
              Espacio reservado para el mapa. Pegá el código de incrustación de
              Google Maps en <code>contacto.mapa</code> dentro de
              <code>src/data/site.js</code>.
            </p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
